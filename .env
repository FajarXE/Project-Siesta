# Telegram Bot Configuration
# REQUIRED: Get these from https://my.telegram.org/apps
TG_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
APP_ID=YOUR_APP_ID_HERE
API_HASH=YOUR_API_HASH_HERE
BOT_USERNAME=YOUR_BOT_USERNAME_HERE
ADMINS=YOUR_TELEGRAM_USER_ID_HERE

# Database Configuration
# REQUIRED: MongoDB connection details (NEW FORMAT)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=siesta_bot

# Legacy support (will be deprecated in future versions)
# DATABASE_URL=mongodb://localhost:27017/projectsiesta

# Working Directory
WORK_DIR=./bot/
DOWNLOADS_FOLDER=DOWNLOADS
LOCAL_STORAGE=./bot/DOWNLOADS

# File/Folder Naming
PLAYLIST_NAME_FORMAT={title} - Playlist
TRACK_NAME_FORMAT={title} - {artist}

# Rclone/Index Configuration (Optional)
RCLONE_CONFIG=
RCLONE_DEST=remote:newfolder
INDEX_LINK=

# Qobuz Configuration (Optional)
QOBUZ_EMAIL=
QOBUZ_PASSWORD=
QOBUZ_USER=
QOBUZ_TOKEN=

# Deezer Configuration (Optional)
DEEZER_EMAIL=
DEEZER_PASSWORD=
DEEZER_BF_SECRET=
DEEZER_ARL=

# Tidal Configuration (Optional)
ENABLE_TIDAL=
TIDAL_MOBILE=
TIDAL_MOBILE_TOKEN=
TIDAL_ATMOS_MOBILE_TOKEN=
TIDAL_TV_TOKEN=
TIDAL_TV_SECRET=
TIDAL_CONVERT_M4A=False
TIDAL_REFRESH_TOKEN=
TIDAL_COUNTRY_CODE=

# Beatport Configuration (Optional)
BEATPORT_USERNAME=
BEATPORT_PASSWORD=

# OrpheusDL settings
ORPHEUSDL_TIMEOUT=3600

