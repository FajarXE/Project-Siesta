# Telegram Bot Configuration
TG_BOT_TOKEN=
APP_ID=
API_HASH=
BOT_USERNAME=
ADMINS=

# Database Configuration
# REQUIRED: MongoDB connection details (NEW FORMAT)
MONGODB_URI=
MONGODB_DB=

# Legacy support (will be deprecated in future versions)
# DATABASE_URL=

# Working Directory
WORK_DIR=./bot/
DOWNLOADS_FOLDER=DOWNLOADS
LOCAL_STORAGE=./bot/DOWNLOADS

# Pyrogram Session Configuration (prevents AUTH_KEY_DUPLICATED)
SESSION_NAME=siesta
SESSION_DIR=/data/sessions

# Distributed Lock Configuration (optional, enabled by default)
ENABLE_DISTRIBUTED_LOCK=true
LOCK_TTL_MINUTES=5

# File/Folder Naming
PLAYLIST_NAME_FORMAT={title} - Playlist
TRACK_NAME_FORMAT={title} - {artist}

# Rclone/Index Configuration
RCLONE_CONFIG=
RCLONE_DEST=remote:newfolder
INDEX_LINK=

# Qobuz Configuration
QOBUZ_EMAIL=
QOBUZ_PASSWORD=
QOBUZ_USER=
QOBUZ_TOKEN=

# Deezer Configuration
DEEZER_EMAIL=
DEEZER_PASSWORD=
DEEZER_BF_SECRET=
DEEZER_TRACK_URL_KEY=
DEEZER_ARL=

# Concurrent Workers
MAX_WORKERS=5

# Tidal configuration
ENABLE_TIDAL=
TIDAL_MOBILE=
TIDAL_MOBILE_TOKEN=
TIDAL_ATMOS_MOBILE_TOKEN=
TIDAL_TV_TOKEN=
TIDAL_TV_SECRET= 

# Add Beatport Configuration
BEATPORT_USERNAME=
BEATPORT_PASSWORD=

OROHEUSDL_TIMEOUT=